@@@ OK archivo : calculadora completa
%estructuras
estructura Historial:
    entero cantidad
    flotante valores[10]

%funciones

/* ---------- Operaciones basicas ---------- */

definir sumar(flotante a, flotante b) -> flotante:
    retornar a + b

definir dividir(flotante a, flotante b) -> flotante:
    si(b == 0) entonces
        imprimir("Error: division entre cero, se devuelve 0")
        retornar 0.0
    retornar a / b

// Despacha las operaciones usando elegir
definir aplicar(entero op, flotante a, flotante b) -> flotante:
    flotante r = 0.0
    elegir(op) :
        caso 1:
            r = sumar(a, b)
            romper
        caso 4:
            r = dividir(a, b)
            romper
        siempre:
            imprimir("Operacion desconocida")
            romper
    retornar r

definir potencia(flotante base, entero exp) -> flotante:
    flotante r = 1.0
    entero e = exp
    si(e < 0) entonces
        e = 0 - e
    para(entero i = 0; i < e; i++):
        r = r * base
    si(exp < 0) entonces
        retornar 1.0 / r
    retornar r

definir factorial(entero n) -> entero:
    si(n < 2) entonces
        retornar 1
    retornar n * factorial(n - 1)

definir esPrimo(entero n) -> bool:
    si(n < 2) entonces
        retornar falso
    entero d = 2
    mientras(d * d < n + 1) hacer
        si(n % d == 0) entonces
            retornar falso
        d++
    retornar verdadero

definir registrar({}Historial h, flotante valor):
    si (h.cantidad < 10) entonces
        h.valores[h.cantidad] = valor
        h.cantidad++
    contrario
        imprimir("Historial lleno")

@@@ OK archivo : matrices con parametros arreglo
%funciones
definir imprimirMatriz([][]entero m, entero n):
    para(entero i = 0; i < n; i++):
        cadena fila = ""
        para(entero j = 0; j < n; j++):
            fila = fila + m[i][j] + " "
        imprimir(fila)

definir transponer([][]entero m, entero n) -> entero[][]:
    entero r[3][3]
    para(entero i = 0; i < n; i++):
        para(entero j = 0; j < n; j++):
            r[j][i] = m[i][j]
    retornar r

definir menu() -> entero:
    entero opcion = 0
    hacer:
        imprimir("1. Transponer", "2. Salir")
        opcion = leer()
    mientras(opcion < 1 || opcion > 2)
    retornar opcion
