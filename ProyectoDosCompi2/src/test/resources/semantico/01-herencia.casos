Herencia, @Override, super y polimorfismo (proyecto 2).

@@@ OK : herencia simple con super y Override
@@> c3d: call Perro_comer
@@> c3d: call Animal_constructor_cadena
=== main.pig
import Animal.z
import Perro.z
VARIABILES>
esto a : novus Perro("Firulais") : Animal ;
MAIOR>
a.comer();
FINIS;
=== Animal.z
public class Animal {
    protected String nombre;
    public Animal(String nombre) {
        this.nombre = nombre;
    }
    public void comer() {
        println(nombre + " come");
    }
}
=== Perro.z
public class Perro extends Animal {
    public Perro(String nombre) {
        super(nombre);
    }
    @Override
    public void comer() {
        super.comer();
        println("y mueve la cola");
    }
}

@@@ OK : super implicito al constructor vacio del padre
@@> c3d: call Animal_constructor
=== Perro.z
public class Perro extends Animal {
    public Perro() {
        println("perro");
    }
}
=== Animal.z
public class Animal {
    public Animal() {
    }
}

