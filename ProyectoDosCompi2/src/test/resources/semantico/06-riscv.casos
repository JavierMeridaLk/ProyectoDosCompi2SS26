@@@ OK : menu que lee hasta salir
@@> entrada: 1\n5\n1\n7\n2\n3\n
@@> salida: >+5>+7>=12>fin
=== main.pig
VARIABILES>
esto op : numerus 0;
esto x : numerus 0;
esto total : numerus 0;
MAIOR>
dum (op != 3) {
    >> ">";
    op <<
    si (op == 1) {
        x <<
        total = total + x;
        >> "+" + x;
    } finis;
    si (op == 2) {
        >> "=" + total;
    } finis;
} finis;
>> "fin";
FINIS;

@@@ OK : readln de decimal en Zetariano y operaciones
