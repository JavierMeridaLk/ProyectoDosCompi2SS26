import Lector.z
VARIABILES>
esto l : novus Lector() : Lector ;
MAIOR>
FINIS;

@@@ OK : recursividad en Y desde pig
@@> salida: 120 55
=== main.pig
import lib.r.y
MAIOR>
>> factorial(5) >> " " >> fibonacci(10);
FINIS;
=== lib/r.y
%funciones
definir factorial(entero n) -> entero:
    si(n < 2) entonces
        retornar 1
    retornar n * factorial(n - 1)

definir fibonacci(entero n) -> entero:
    si(n < 2) entonces
        retornar n
    retornar fibonacci(n - 1) + fibonacci(n - 2)

