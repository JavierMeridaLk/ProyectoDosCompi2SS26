@@@ OK : funcion recursiva con un marco grande
@@> salida: e1.0e1.19/e2.0e2.19/e3.0e3.19/\n
=== main.pig
import lib.e.y
MAIOR>
>> eco(3);
>> "\n";
FINIS;
=== lib/e.y
%funciones
definir eco(entero n) -> cadena:
    si (n == 0) entonces
        retornar ""
    cadena a0 = "e" + n + "." + 0
    cadena a1 = "e" + n + "." + 1
    cadena a2 = "e" + n + "." + 2
    cadena a3 = "e" + n + "." + 3
    cadena a4 = "e" + n + "." + 4
    cadena a5 = "e" + n + "." + 5
    cadena a6 = "e" + n + "." + 6
    cadena a7 = "e" + n + "." + 7
    cadena a8 = "e" + n + "." + 8
    cadena a9 = "e" + n + "." + 9
    cadena a10 = "e" + n + "." + 10
    cadena a11 = "e" + n + "." + 11
    cadena a12 = "e" + n + "." + 12
    cadena a13 = "e" + n + "." + 13
    cadena a14 = "e" + n + "." + 14
    cadena a15 = "e" + n + "." + 15
    cadena a16 = "e" + n + "." + 16
    cadena a17 = "e" + n + "." + 17
    cadena a18 = "e" + n + "." + 18
    cadena a19 = "e" + n + "." + 19
    retornar eco(n - 1) + a0 + a19 + "/"

