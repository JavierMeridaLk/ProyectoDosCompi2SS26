@@@ ERROR : novus de una estructura
@@> error: 'Punto' no es una clase
=== main.pig
import lib.d.y
VARIABILES>
esto p : novus Punto() : Punto ;
MAIOR>
FINIS;
=== lib/d.y
%estructuras
estructura Punto:
    entero x
%funciones

