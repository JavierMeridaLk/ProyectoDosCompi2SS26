FINIS;

@@@ SINTACTICO archivo : objeto tipado sin punto y coma rompe la siguiente linea
VARIABILES>
esto a : novus A() : A
esto b : numerus 1;
MAIOR>
FINIS;

@@@ OK archivo : saltos de linea de windows
@@> crlf
## comentario
   de bloque ##
VARIABILES>
esto p : null : Persona;
MAIOR>
>> "hola";
FINIS;
