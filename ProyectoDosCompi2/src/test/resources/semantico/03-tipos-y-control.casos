@@@ OK : arreglos y matrices
=== A.z
public class A {
    public int m() {
        int[] a = new int[5];
        int[][] m = {{1, 2}, {3, 4}};
        int[] b = new int[]{1, 2, 3};
        a[0] = m[1][1] + b[2];
        a[1]++;
        return a[0];
    }
}

