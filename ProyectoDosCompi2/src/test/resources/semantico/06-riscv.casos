@@@ OK : atributo decimal heredado con protected y super
@@> salida: 69.75\n70.75\nQ70.75 de Ana\n
=== main.pig
import Cuenta.z
import Ahorro.z
VARIABILES>
esto c : novus Ahorro("Ana") : Cuenta ;
MAIOR>
c.depositar(100);
c.retirar(30.25);
c.mostrar();
FINIS;
=== Cuenta.z
public class Cuenta {
    protected double saldo = 0.0;
    protected String titular;
    public Cuenta(String titular) {
        this.titular = titular;
    }
    public void depositar(double monto) {
        saldo += monto;
    }
    public void retirar(double monto) {
        saldo = saldo - monto;
    }
    public void mostrar() {
        println(saldo);
    }
}
=== Ahorro.z
public class Ahorro extends Cuenta {
    public Ahorro(String titular) {
        super(titular);
    }
    @Override
    public void mostrar() {
        super.mostrar();
        saldo++;
        println(super.saldo);
        println("Q" + saldo + " de " + titular);
    }
}

@@@ OK : recursion mutua entre funciones de Y
@@> salida: verum verum falsus
=== main.pig
import lib.m.y
MAIOR>
>> esPar(10) >> " " >> esImpar(7) >> " " >> esPar(3);
FINIS;
=== lib/m.y
%funciones
definir esPar(entero n) -> bool:
    si (n == 0) entonces
        retornar verdadero
    retornar esImpar(n - 1)

definir esImpar(entero n) -> bool:
    si (n == 0) entonces
        retornar falso
    retornar esPar(n - 1)

