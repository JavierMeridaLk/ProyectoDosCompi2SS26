Pig Latin: estructura del programa (importaciones y secciones).

@@@ OK archivo : programa minimo
MAIOR>
FINIS;

@@@ OK archivo : programa minimo en una linea
MAIOR> FINIS;

@@@ OK archivo : hola mundo
MAIOR>
>> "Hola mundo";
FINIS;

@@@ OK archivo : seccion de variables vacia
VARIABILES>
MAIOR>
FINIS;

@@@ OK archivo : variables y principal
VARIABILES>
esto x : numerus 5;
MAIOR>
>> x;
FINIS;

@@@ OK archivo : importacion sin punto y coma
import clases.Persona.z
MAIOR>
FINIS;

@@@ OK archivo : importacion con punto y coma
import clases.Persona.z;
MAIOR>
FINIS;

@@@ OK archivo : importacion de archivo y
import lib.utilidades.y
MAIOR>
FINIS;

@@@ OK archivo : importacion de ruta corta
import Persona.z
MAIOR>
FINIS;

@@@ OK archivo : importacion de ruta larga
import a.b.c.d.e.Clase.z
MAIOR>
FINIS;

@@@ OK archivo : varias importaciones mezcladas
import clases.Persona.z;
import clases.Profesor.z
import lib.Estadisticas.y;
VARIABILES>
MAIOR>
FINIS;

@@@ OK archivo : comentarios en todas partes
## comentario
   de bloque ##
// comentario de linea
import clases.A.z // despues de importar
VARIABILES> ## en la seccion ##
esto x : numerus 1; // variable
MAIOR>
// dentro del principal
FINIS; // al final

@@@ OK archivo : comentario de bloque con numeral suelto
## un # suelto no cierra ##
MAIOR>
FINIS;

@@@ SINTACTICO archivo : archivo vacio

@@@ SINTACTICO archivo : falta seccion principal
VARIABILES>
esto x : numerus 1;

@@@ SINTACTICO archivo : falta FINIS
MAIOR>
>> "hola";

@@@ SINTACTICO archivo : FINIS sin punto y coma
MAIOR>
FINIS

@@@ SINTACTICO archivo : FINIS en minusculas
MAIOR>
finis;

@@@ SINTACTICO archivo : MAIOR sin mayor que
MAIOR
FINIS;

@@@ SINTACTICO archivo : VARIABILES sin mayor que
VARIABILES
MAIOR>
FINIS;

@@@ SINTACTICO archivo : secciones en orden invertido
MAIOR>
FINIS;
VARIABILES>

@@@ SINTACTICO archivo : seccion principal repetida
MAIOR>
FINIS;
MAIOR>
FINIS;

@@@ SINTACTICO archivo : seccion de variables repetida
VARIABILES>
VARIABILES>
MAIOR>
FINIS;

@@@ SINTACTICO archivo : codigo despues de FINIS
MAIOR>
FINIS;
>> "fuera";

@@@ SINTACTICO archivo : importacion despues de variables
VARIABILES>
import clases.A.z
MAIOR>
FINIS;

@@@ SINTACTICO archivo : importacion sin ruta
import
MAIOR>
FINIS;

@@@ SINTACTICO archivo : importacion sin extension
import Persona
MAIOR>
FINIS;

@@@ SINTACTICO archivo : importacion con barras
import clases/Persona.z
MAIOR>
FINIS;

@@@ SINTACTICO archivo : importacion con comillas
import "clases.Persona.z"
MAIOR>
FINIS;

@@@ SINTACTICO archivo : instruccion en la seccion de variables
VARIABILES>
>> "hola";
MAIOR>
FINIS;

@@@ SINTACTICO archivo : maior en minusculas
maior>
FINIS;

@@@ LEXICO archivo : comentario de bloque sin cerrar
## nunca se cierra
MAIOR>
FINIS;

@@@ LEXICO archivo : comentario de bloque sin cerrar al final
MAIOR>
FINIS;
## abierto
