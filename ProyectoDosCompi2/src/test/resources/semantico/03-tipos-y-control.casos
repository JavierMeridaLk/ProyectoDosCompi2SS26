@@@ OK : pig latin con todo tipo de instrucciones
=== main.pig
import lib.f.y
VARIABILES>
esto n : numerus 3;
esto d : decimalis 2.5;
esto t : textum "hola";
esto l : littera 'x';
esto b : bool verum;
esto activo : falsus;
series v[3] : numerus {1, 2, 3};
series m[2][2] : decimalis;
MAIOR>
d = n * d + 1;
v[0] = v[1] + v[2];
m[0][1] = 1.5;
n++;
si (n > 2 && non activo) {
    >> "mayor" >> n;
} aliter (n == 2) {
    >> "dos";
} aliter {
    >> "menor";
} finis;
dum (n > 0) {
    n--;
    si (n == 1) {
        perge;
    } finis;
    si (n == 5) {
        interrumpe;
    } finis;
} finis;
facere {
    n = n + 1;
} dum (n < 3);
per (esto i : numerus 0; i < 3; i++) {
    >> v[i];
}
n <<
t <<
>> doble(n) >> t >> l >> b;
FINIS;
=== lib/f.y
%funciones
definir doble(entero n) -> entero:
    retornar n * 2

