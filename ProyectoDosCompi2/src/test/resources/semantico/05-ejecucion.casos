esto t : novus Tabla() : Tabla ;
MAIOR>
FINIS;

@@@ OK : estructuras de Y por referencia
@@> salida: 4,2|9|Central
=== main.pig
import lib.e.y
VARIABILES>
esto p : Punto {1, 2, {"Norte"}};
esto q : Punto;
MAIOR>
mover(p, 3);
q.x = 9;
>> p.x >> "," >> p.y >> "|" >> q.x >> "|" >> calle();
FINIS;
=== lib/e.y
%estructuras
estructura Direccion:
    cadena nombre
estructura Punto:
    entero x
    entero y
    Direccion lugar
%funciones
definir mover({}Punto p, entero dx):
    p.x = p.x + dx

definir calle() -> cadena:
    Punto p
    p.lugar.nombre = "Central"
    retornar p.lugar.nombre

@@@ OK : ciclos con perge e interrumpe
@@> salida: 1 3 5 |3 2 1 |0 1 2
=== main.pig
VARIABILES>
esto i : numerus 0;
MAIOR>
dum (i < 10) {
    i++;
    si (i == 7) {
        interrumpe;
    } finis;
    si (i - (i / 2) * 2 == 0) {
        perge;
    } finis;
    >> i >> " ";
} finis;
>> "|";
i = 3;
facere {
    >> i >> " ";
    i--;
} dum (i > 0);
>> "|";
per (esto k : numerus 0; k < 3; k++) {
    >> k;
    si (k < 2) {
        >> " ";
    } finis;
}
FINIS;

@@@ OK : switch con caida entre casos y default
@@> salida: dos tres\ntres\notro\n
=== S.z
public class S {
    public S() {
        probar(2);
        probar(3);
        probar(9);
    }
    private void probar(int x) {
        switch (x) {
            case 1:
                println("uno");
                break;
            case 2:
                print("dos ");
            case 3:
                println("tres");
                break;
            default:
                println("otro");
        }
    }
}
=== main.pig
import S.z
VARIABILES>
esto s : novus S() : S ;
MAIOR>
FINIS;

@@@ OK : elegir en Y
@@> salida: suma\nresta\notra\n
=== main.pig
import lib.op.y
MAIOR>
nombre(1);
nombre(2);
nombre(5);
FINIS;
=== lib/op.y
%funciones
definir nombre(entero op):
    elegir(op):
        caso 1:
            imprimir("suma")
            romper
        caso 2:
            imprimir("resta")
            romper
        siempre:
            imprimir("otra")

