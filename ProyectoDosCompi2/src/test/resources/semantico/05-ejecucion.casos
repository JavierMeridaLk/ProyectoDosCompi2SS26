@@@ OK : comparar cadenas por su contenido
@@> salida: 1001
=== main.pig
VARIABILES>
esto a : textum "hola";
esto b : textum "ho";
MAIOR>
b = b + "la";
si (a == b) {
    >> 1;
} aliter {
    >> 0;
} finis;
si (a == "holas") {
    >> 1;
} aliter {
    >> 0;
} finis;
si (a != "mundo" && "" == "") {
    >> 0;
} aliter {
    >> 1;
} finis;
si ("abc" != "abd") {
    >> 1;
} finis;
FINIS;

@@@ OK : leer enteros decimales texto caracter y booleano
@@> entrada: 42\n-7\n2.5\nhola mundo\nzeta\nverum\n
@@> salida: 43|-14|5.0|hola mundo!|z|verum
=== main.pig
VARIABILES>
esto n : numerus 0;
esto m : numerus 0;
esto d : decimalis 0.0;
esto t : textum "";
esto l : littera 'a';
esto b : bool falsus;
MAIOR>
n <<
m <<
d <<
t <<
l <<
b <<
>> n + 1 >> "|" >> m * 2 >> "|" >> d * 2 >> "|" >> t + "!" >> "|" >> l >> "|" >> b;
FINIS;

