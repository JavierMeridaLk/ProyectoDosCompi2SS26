@@@ OK : objetos nulos y atributos por defecto
@@> salida: nulo|creado|0
=== main.pig
import Nodo.z
VARIABILES>
esto n : null : Nodo ;
MAIOR>
si (n == null) {
    >> "nulo|";
} finis;
n = novus Nodo();
si (n != null) {
    >> "creado|";
} finis;
>> n.valor();
FINIS;
=== Nodo.z
public class Nodo {
    private int dato;
    private Nodo siguiente;
    public Nodo() {
    }
    public int valor() {
        if (siguiente == null) {
            return dato;
        }
        return -1;
    }
}

@@@ OK : lista enlazada con objetos en el heap
@@> salida: 30 20 10 |3
=== main.pig
import Lista.z
import Nodo.z
VARIABILES>
esto l : novus Lista() : Lista ;
MAIOR>
l.agregar(10);
l.agregar(20);
l.agregar(30);
l.imprimir();
>> "|" >> l.tamanio();
FINIS;
=== Nodo.z
public class Nodo {
    public int dato;
    public Nodo siguiente;
    public Nodo(int dato, Nodo siguiente) {
        this.dato = dato;
        this.siguiente = siguiente;
    }
}
=== Lista.z
public class Lista {
    private Nodo cabeza;
    private int n = 0;
    public Lista() {
    }
    public void agregar(int x) {
        cabeza = new Nodo(x, cabeza);
        n++;
    }
    public void imprimir() {
        Nodo actual = cabeza;
        while (actual != null) {
            print(actual.dato + " ");
            actual = actual.siguiente;
        }
    }
    public int tamanio() {
        return n;
    }
}

@@@ OK : asignaciones compuestas e incrementos
@@> salida: 16 8 2 0 7.50 3
=== C.z
public class C {
    public C() {
        int a = 10;
        a += 6;
        print(a + " ");
        a -= 8;
        print(a + " ");
        a /= 4;
        print(a + " ");
        a %= 2;
        print(a + " ");
        double d = 2.5;
        d *= 3;
        print(d + "");
        int i = 3;
        int j = i++ + ++i;
        print(" " + (j - i + 0) + "");
    }
}
