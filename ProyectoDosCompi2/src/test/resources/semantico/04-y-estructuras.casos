    flotante x = leer()
    cadena s = leer()

@@@ OK : arreglo de estructuras con lista
=== lib/e.y
%estructuras
estructura P:
    entero x
    cadena nombre
%funciones
definir f() -> entero:
    P lista[2] = {{1, "a"}, {2, "b"}}
    retornar lista[1].x

