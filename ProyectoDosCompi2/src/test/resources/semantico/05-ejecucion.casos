@@@ OK : arreglos en Zetariano con new y dimensiones
@@> salida: 0 1 2\n2 3 4\n
=== Tabla.z
public class Tabla {
    public Tabla() {
        int[][] t = new int[2][3];
        for (int i = 0; i < 2; i++) {
            for (int j = 0; j < 3; j++) {
                t[i][j] = i * 2 + j;
            }
        }
        for (int i = 0; i < 2; i++) {
            println(t[i][0] + " " + t[i][1] + " " + t[i][2]);
        }
    }
}
