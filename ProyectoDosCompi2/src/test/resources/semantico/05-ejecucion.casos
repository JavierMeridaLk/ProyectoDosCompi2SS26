@@@ OK : metodo de y llamado desde zetariano y valor de retorno de objeto
@@> salida: 42|Ana
=== main.pig
import P.z
import lib.u.y
VARIABILES>
esto p : novus P("Ana") : P ;
MAIOR>
>> p.doble(21) >> "|" >> p.yo().nombre;
FINIS;
=== P.z
public class P {
    public String nombre;
    public P(String nombre) {
        this.nombre = nombre;
    }
    public int doble(int x) {
        return duplicar(x);
    }
    public P yo() {
        return this;
    }
}
=== lib/u.y
%funciones
definir duplicar(entero n) -> entero:
    retornar n * 2
