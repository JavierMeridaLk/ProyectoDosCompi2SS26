Zetariano: lo nuevo del proyecto 2 (herencia, @Override, super, this).
Las reglas de @Override obligatorio/sobrante, visibilidad y super implicito son
del semantico; aqui solo se valida la sintaxis.

@@@ OK miembro : Override en metodo publico
@Override
public void imprimir() {
}
@@> tiene: DeclaracionMetodo

@@@ OK miembro : Override en la misma linea
@Override public String toString() { return "Prueba"; }

@@@ OK miembro : Override en metodo default
@Override
void mover() {
}

@@@ OK miembro : Override en metodo protegido
@Override
protected int calcular(int a, int b) {
    return a * b;
}

@@@ OK miembro : Override en metodo privado (lo rechaza el semantico)
@Override
private void secreto() {
}

@@@ OK miembro : Override con retorno covariante
@Override
public Profesor crear() {
    return new Profesor();
}

@@@ OK miembro : Override en metodo estatico (lo decide el semantico)
@Override
public static void estatico() {
}

@@@ OK miembro : Override que retorna arreglo
@Override
public int[] valores() {
    return new int[3];
}

@@@ OK miembro : Override con comentario entre anotacion y metodo
@Override
// sobrescribe el del padre
public void m() {
}

@@@ OK miembro : varios metodos sobrescritos
@Override
public void a() {}
@Override
public void b() {}
public void c() {}

@@@ OK miembro : super vacio al inicio del constructor
public Prueba() {
    super();
}
@@> tiene: CuerpoConstructor, LlamadaSuper

@@@ OK miembro : super con argumentos
public Prueba(String nombre, int edad) {
    super(nombre, edad);
}

@@@ OK miembro : super con expresiones como argumentos
public Prueba(int a) {
    super(a * 2 + 1, "x" + a, new Lista(), null, this.valor);
}

@@@ OK miembro : super seguido de mas instrucciones
public Prueba(String n, String raza) {
    super(n);
    this.raza = raza;
    println("creado");
}

@@@ OK miembro : constructor sin super (implicito)
public Prueba(String raza) {
    this.raza = raza;
}
@@> notiene: LlamadaSuper

@@@ OK miembro : comentario antes del super
public Prueba() {
    // primero el padre
    super();
}

@@@ OK sentencia : llamar metodo del padre con super
super.comer();
@@> tiene: PrimarioSuperMetodo

@@@ OK sentencia : leer atributo del padre con super
int e = super.edad;
@@> tiene: PrimarioSuperAtributo

@@@ OK sentencia : super con argumentos en un metodo
super.mover(1, 2.5, "norte");

@@@ OK sentencia : resultado de super en expresion
println(super.toString() + " y algo mas");

@@@ OK sentencia : encadenar despues de super
super.getDuenio().getNombre();
@@> tiene: PrimarioSuperMetodo, ExpresionLlamadaMetodo

@@@ OK sentencia : asignar atributo del padre con super
super.nombre = "Firulais";
@@> tiene: PrimarioSuperAtributo, ExpresionAsignacion

@@@ OK sentencia : indice sobre atributo del padre
super.valores[0] = 10;

@@@ OK sentencia : super en una condicion
if (super.edad > 3 && super.esAdulto()) {
    println("adulto");
}

@@@ OK sentencia : this como valor
Nodo n = this;
@@> tiene: PrimarioThis

@@@ OK sentencia : this en atributo y metodo
this.x = this.calcular(this.y);

@@@ OK sentencia : this como argumento
lista.agregar(this);

@@@ OK sentencia : comparar this con null
if (this != null) {
}

@@@ OK sentencia : objeto declarado con tipo del padre
Persona p = new Profesor("Ana", 30);

@@@ OK sentencia : objeto nulo
Persona p = null;
p = null;
if (p == null) {
    p = new Persona();
}

@@@ OK archivo : herencia completa con super y Override
public class Perro extends Animal {
    private String raza;

    public Perro(String nombre, int edad, String raza) {
        super(nombre, edad);
        this.raza = raza;
    }

    public Perro() {
        raza = "criollo";
    }

    @Override
    public void comer() {
        super.comer();
        println("El perro de " + super.edad + " años terminó.");
    }

    @Override
    public String describir() {
        return super.describir() + " raza " + this.raza;
    }

    public void ladrar() {
        println(nombre + " está ladrando: ¡Guau, guau!");
    }
}

@@@ OK archivo : cadena de herencia de tres niveles (nivel final)
public class Gerente extends Empleado {
    protected double bono;

    public Gerente(String nombre, double salario, double bono) {
        super(nombre, salario);
        this.bono = bono;
    }

    @Override
    public double calcularPago() {
        return super.calcularPago() + bono;
    }
}

@@@ SINTACTICO miembro : Override en atributo
@Override
int x;

@@@ SINTACTICO miembro : Override en constructor
@Override
public Prueba() {
}

@@@ SINTACTICO miembro : Override repetido
@Override
@Override
public void m() {
}

@@@ SINTACTICO miembro : Override despues del modificador
public @Override void m() {
}

@@@ SINTACTICO miembro : Override sin metodo al final de la clase
public void m() {
}
@Override

@@@ SINTACTICO miembro : Override con parentesis
@Override()
public void m() {
}

@@@ SINTACTICO miembro : Override con texto pegado
@Overrides
public void m() {
}

@@@ LEXICO miembro : override en minusculas
@override
public void m() {
}

@@@ LEXICO miembro : arroba separada de Override
@ Override
public void m() {
}

@@@ LEXICO miembro : otra anotacion no existe
@Deprecated
public void m() {
}

@@@ SINTACTICO miembro : super despues de otra instruccion
public Prueba() {
    println("antes");
    super();
}

@@@ SINTACTICO miembro : super llamado dos veces
public Prueba() {
    super();
    super(1);
}

@@@ SINTACTICO miembro : super sin punto y coma
public Prueba() {
    super(1)
}

@@@ SINTACTICO miembro : super sin parentesis
public Prueba() {
    super;
}

@@@ SINTACTICO miembro : super dentro de un if del constructor
public Prueba(int a) {
    if (a > 0) {
        super(a);
    }
}

@@@ SINTACTICO miembro : super dentro de un bloque anidado del constructor
public Prueba() {
    {
        super();
    }
}

@@@ SINTACTICO miembro : llamada a super en un metodo
public void m() {
    super();
}

@@@ SINTACTICO miembro : this como llamada a constructor (no soportado)
public Prueba() {
    this(0);
}

@@@ SINTACTICO sentencia : super solo como valor
Animal a = super;

@@@ SINTACTICO sentencia : asignar a super
super = otro;

@@@ SINTACTICO sentencia : super con indice directo
super[0] = 1;

@@@ SINTACTICO sentencia : super punto sin nombre
super.();

@@@ SINTACTICO sentencia : super con dos puntos seguidos
super..m();

@@@ SINTACTICO sentencia : llamada super sin cerrar
super.m(1, 2;

@@@ SINTACTICO sentencia : super como nombre de variable
int super = 1;

@@@ SINTACTICO sentencia : this como nombre de variable
int this = 1;

@@@ SINTACTICO sentencia : null como nombre de variable
Persona null = new Persona();
