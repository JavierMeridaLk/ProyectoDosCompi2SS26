Pig Latin: expresiones. Se escriben dentro de ">> <expr>;".

@@@ OK expr : literales de todos los tipos
1 >> 2.5 >> "texto" >> 'c' >> verum >> falsus >> null

@@@ OK expr : nulo es literal
null
@@> forma: Literal

@@@ OK expr : multiplicacion antes que suma
1 + 2 * 3
@@> forma: Aditiva(Literal,Multiplicativa(Literal,Literal))

@@@ OK expr : parentesis cambian la precedencia
(1 + 2) * 3
@@> forma: Multiplicativa(Parentesis(Aditiva(Literal,Literal)),Literal)

@@@ OK expr : resta asociativa a la izquierda
a - b - c
@@> forma: Aditiva(Aditiva(Acceso,Acceso),Acceso)

@@@ OK expr : division asociativa a la izquierda
a / b / c
@@> forma: Multiplicativa(Multiplicativa(Acceso,Acceso),Acceso)

@@@ OK expr : and antes que or
a || b && c
@@> forma: O(Acceso,Y(Acceso,Acceso))

@@@ OK expr : or asociativo a la izquierda
a || b || c
@@> forma: O(O(Acceso,Acceso),Acceso)

@@@ OK expr : non antes que and
non a && b
@@> forma: Y(Unaria(Acceso),Acceso)

@@@ OK expr : doble non
non non a
@@> forma: Unaria(Unaria(Acceso))

@@@ OK expr : negacion con signo de admiracion
!a
@@> forma: Unaria(Acceso)

@@@ OK expr : menos unario antes que multiplicacion
-a * b
@@> forma: Multiplicativa(Unaria(Acceso),Acceso)

@@@ OK expr : relacional antes que igualdad
a == b < c
@@> forma: Igualdad(Acceso,Relacional(Acceso,Acceso))

@@@ OK expr : suma antes que relacional
a + 1 >= b * 2
@@> forma: Relacional(Aditiva(Acceso,Literal),Multiplicativa(Acceso,Literal))

@@@ OK expr : comparacion con nulo
p == null
@@> forma: Igualdad(Acceso,Literal)

@@@ OK expr : distinto de nulo y acceso
p != null && p.activo
@@> forma: Y(Igualdad(Acceso,Literal),Acceso)

@@@ OK expr : indice con expresion
a[i + 1]
@@> forma: Acceso(Aditiva(Acceso,Literal))

@@@ OK expr : matriz con indices
m[i][j + 1]
@@> forma: Acceso(Acceso,Aditiva(Acceso,Literal))

@@@ OK expr : llamada con argumentos
f(a, b + 1)
@@> forma: Acceso(Acceso,Aditiva(Acceso,Literal))
@@> tiene: SufijoLlamada

@@@ OK expr : atributos encadenados
a.b.c
@@> forma: Acceso
@@> tiene: SufijoAtributo

@@@ OK expr : metodo de atributo de elemento
juego.palabras[i].longitud()
@@> forma: Acceso(Acceso)
@@> tiene: SufijoIndice, SufijoAtributo, SufijoLlamada

@@@ OK expr : objeto nuevo con llamada encadenada
novus Persona(1).getNombre()
@@> forma: NuevoObjeto(Literal)
@@> tiene: ExpresionNuevoObjeto, SufijoLlamada

@@@ OK expr : objeto nuevo como argumento
f(novus Persona(), null)
@@> forma: Acceso(NuevoObjeto,Literal)

@@@ OK expr : expresion larga mezclada
(a + b) * c - d / e >= f && non g || h != i
@@> forma: O(Y(Relacional(Aditiva(Multiplicativa(Parentesis(Aditiva(Acceso,Acceso)),Acceso),Multiplicativa(Acceso,Acceso)),Acceso),Unaria(Acceso)),Igualdad(Acceso,Acceso))

@@@ OK expr : parentesis redundantes
((x))
@@> forma: Parentesis(Parentesis(Acceso))

@@@ OK expr : mayor mayor es otra salida
a >> b
@@> tiene: Escritura

@@@ OK expr : this es un identificador comun en pig latin
this.x

@@@ SINTACTICO expr : operador al final
1 +

@@@ SINTACTICO expr : parentesis sin cerrar
(a + b

@@@ SINTACTICO expr : asignacion dentro de expresion
a = b

@@@ SINTACTICO expr : incremento dentro de expresion
a++

@@@ SINTACTICO expr : lectura dentro de escritura
a << b

@@@ SINTACTICO expr : novus sin parentesis
novus Persona

@@@ SINTACTICO expr : atributo de nulo
null.x

@@@ SINTACTICO expr : decimal sin parte entera
.5

@@@ SINTACTICO expr : decimal sin parte decimal
5.

@@@ SINTACTICO expr : dos operandos sin operador
a b

@@@ SINTACTICO expr : not en ingles
not a

@@@ SINTACTICO expr : and y or en palabras
a and b

@@@ LEXICO expr : modulo no existe en pig latin
a % b

@@@ LEXICO expr : ternario no existe
a ? b : c

@@@ LEXICO expr : and de bits
a & b

@@@ LEXICO expr : or de bits
a | b

@@@ LEXICO expr : caracter con dos letras
'ab'

@@@ LEXICO expr : cadena sin cerrar
"hola

@@@ LEXICO expr : simbolo invalido
precio$

@@@ LEXICO expr : numeral simple
a # b
