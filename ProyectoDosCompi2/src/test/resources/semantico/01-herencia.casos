@@@ OK : polimorfismo con despacho dinamico desde pig
@@> c3d: call ImpresoraPDF_imprimir
@@> c3d: call Impresora_imprimir
=== main.pig
import Impresora.z
import ImpresoraPDF.z
VARIABILES>
esto i : novus ImpresoraPDF() : Impresora ;
MAIOR>
i.imprimir();
i = novus Impresora();
i.imprimir();
FINIS;
=== Impresora.z
class Impresora {
    public Impresora() {
    }
    public void imprimir() {
        println("Imprimiendo documento genérico...");
    }
}
=== ImpresoraPDF.z
class ImpresoraPDF extends Impresora {
    public ImpresoraPDF() {
    }
    @Override
    public void imprimir() {
        println("Imprimiendo en formato .PDF optimizado...");
    }
}

