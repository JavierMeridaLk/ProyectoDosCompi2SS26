    public void m() {
        break;
    }
}

@@@ ERROR : continue dentro de un switch sin ciclo
@@> error: 'continue' solo se puede usar dentro de un ciclo
=== A.z
public class A {
    public void m(int x) {
        switch (x) {
            case 1:
                continue;
        }
    }
}

@@@ OK : continue en un switch dentro de un ciclo
=== A.z
public class A {
    public void m() {
        for (int i = 0; i < 5; i++) {
            switch (i) {
                case 1:
                    continue;
                default:
                    break;
            }
        }
    }
}

@@@ ERROR : switch con dos default y case de otro tipo
@@> error: El switch ya tiene un default
@@> error: El operador '==' no se puede aplicar a 'int' y 'String'
=== A.z
public class A {
