Y?: estructuras, funciones y su uso desde Pig Latin y Zetariano.

@@@ OK : calculadora en Y
@@> c3d: func f_factorial
@@> c3d: call f_factorial
=== util.y
%estructuras
estructura Historial:
    entero cantidad
    flotante valores[10]

%funciones
definir factorial(entero n) -> entero:
    si(n < 2) entonces
        retornar 1
    retornar n * factorial(n - 1)

definir aplicar(entero op, flotante a, flotante b) -> flotante:
    flotante r = 0.0
    elegir(op) :
        caso 1:
            r = a + b
            romper
        caso 2:
            r = a - b
            romper
        siempre:
            imprimir("Operacion desconocida")
    retornar r

definir registrar({}Historial h, flotante valor):
    si (h.cantidad < 10) entonces
        h.valores[h.cantidad] = valor
        h.cantidad++
    contrario
        imprimir("Historial lleno")

definir recorrer([]entero datos, entero n) -> entero:
    entero suma = 0
    para(entero i = 0; i < n; i++):
        suma = suma + datos[i]
    entero j = 0
    mientras(j < n) hacer
        j++
    hacer:
        j--
    mientras(j > 0)
    retornar suma

@@@ OK : estructura usada desde pig con lista
=== main.pig
import lib.e.y
VARIABILES>
esto p : Punto {1, 2};
esto q : Punto;
esto vacio : null : Punto;
MAIOR>
q.x = p.x + p.y;
>> mover(p, 3).x;
FINIS;
=== lib/e.y
%estructuras
estructura Punto:
    entero x
    entero y
%funciones
definir mover({}Punto p, entero dx) -> Punto:
    p.x = p.x + dx
    retornar p

