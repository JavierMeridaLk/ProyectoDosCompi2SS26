@@@ OK archivo : lista enlazada completa
public class ListaEnlazada {
    private Nodo cabeza;
    private int tamanio;

    public ListaEnlazada() {
        cabeza = null;
        tamanio = 0;
    }

    public void agregar(int valor) {
        Nodo nuevo = new Nodo(valor);
        if (cabeza == null) {
            cabeza = nuevo;
        } else {
            Nodo actual = cabeza;
            while (actual.siguiente != null) {
                actual = actual.siguiente;
            }
            actual.siguiente = nuevo;
        }
        tamanio++;
    }

    public int obtener(int indice) {
        Nodo actual = cabeza;
        for (int i = 0; i < indice && actual != null; i++) {
            actual = actual.siguiente;
        }
        return actual == null ? -1 : actual.valor;
    }

    public void imprimir() {
        Nodo actual = this.cabeza;
        print("[");
        while (actual != null) {
            print(actual.valor);
            if (actual.siguiente != null) {
                print(", ");
            }
            actual = actual.siguiente;
        }
        println("]");
    }
}

@@@ OK archivo : cuenta bancaria con herencia
public class CuentaCorriente extends Cuenta {
    protected double limiteSobregiro;
    private String[] movimientos = new String[100];
    private int cantidad = 0;

    public CuentaCorriente(String titular, double saldo, double limite) {
        super(titular, saldo);
        this.limiteSobregiro = limite;
    }

    @Override
    public boolean retirar(double monto) {
        if (monto <= 0) {
            return false;
        }
        if (getSaldo() - monto < 0 - limiteSobregiro) {
            println("Fondos insuficientes");
            return false;
        }
        super.retirar(monto);
        movimientos[cantidad] = "Retiro: " + monto;
        cantidad += 1;
        return true;
    }

    @Override
    public String resumen() {
        String texto = super.resumen() + "\n";
        for (int i = 0; i < cantidad; i++) {
            texto = texto + movimientos[i] + "\n";
        }
        return texto;
    }
}

@@@ OK archivo : matrices y switch
public class Matrices {
    public static int[][] multiplicar(int[][] a, int[][] b, int n) {
        int[][] r = new int[n][n];
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                int suma = 0;
                for (int k = 0; k < n; k++) {
                    suma += a[i][k] * b[k][j];
                }
                r[i][j] = suma;
            }
        }
        return r;
    }

    public String nombreOperacion(int op) {
        String nombre = "";
        switch (op) {
            case 1:
                nombre = "suma";
                break;
            case 2:
                nombre = "producto";
                break;
            default:
                nombre = "desconocida";
        }
        return nombre;
    }
}

@@@ OK archivo : recursividad y do while
public class Hanoi {
    private int movimientos;

    public Hanoi() {
        movimientos = 0;
    }

    public void resolver(int n, char origen, char destino, char auxiliar) {
        if (n == 1) {
            println("Mover disco 1 de " + origen + " a " + destino);
            movimientos++;
            return;
        }
        resolver(n - 1, origen, auxiliar, destino);
        println("Mover disco " + n + " de " + origen + " a " + destino);
        movimientos++;
        resolver(n - 1, auxiliar, destino, origen);
    }

    public int leerPositivo() {
        int n = 0;
        do {
            println("Ingrese un numero positivo:");
            n = readln();
        } while (n <= 0);
        return n;
    }
}

@@@ OK archivo : polimorfismo con varias sobrescrituras
public class Circulo extends Figura {
    private double radio;

    public Circulo(double radio) {
        super("Circulo");
        this.radio = radio;
    }

    @Override
    public double area() {
        return 3.1416 * radio * radio;
    }

    @Override
    public double perimetro() {
        return 2 * 3.1416 * radio;
    }

    @Override
    protected String descripcion() {
        return super.descripcion() + " de radio " + radio;
    }

    @Override
    public Circulo copiar() {
        return new Circulo(this.radio);
    }
}

