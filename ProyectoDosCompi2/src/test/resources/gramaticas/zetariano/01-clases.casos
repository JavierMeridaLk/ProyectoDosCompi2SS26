Zetariano: estructura del archivo y declaracion de clases.
Cada archivo .z tiene exactamente una clase.

@@@ OK archivo : clase vacia sin modificador
class A {}

@@@ OK archivo : clase publica vacia
public class A {
}

@@@ OK archivo : clase con varios modificadores
public static class Utilidades {
}

@@@ OK archivo : clase que hereda
public class Perro extends Animal {
}

@@@ OK archivo : clase sin modificador que hereda
class ImpresoraPDF extends Impresora {
}

@@@ OK archivo : clase con comentarios de linea y bloque
// comentario antes de la clase
/* comentario
   de varias lineas */
public class A { // al final de la linea
    /* dentro */ int x; // atributo
}
// comentario despues de la clase

@@@ OK archivo : comentario de bloque con asteriscos internos
/** documentacion *** con asteriscos **/
class A {}

@@@ OK archivo : identificadores con guion bajo y numeros
class _Clase_2 extends Base_1 {
    int _x1;
    int valor_2;
}

@@@ OK archivo : clase con nombre que parece palabra reservada
class Clase extends Superclase {
    int publico;
    int superior;
    int thisValor;
    int nuevo;
}

@@@ OK archivo : todo en una sola linea
public class A extends B { int x = 1; public A() { super(); } @Override public void m() { println(x); } }

@@@ OK archivo : ejemplo del enunciado Animal
// Superclase (Clase padre) en el archivo correspondiente
public class Animal {
    String nombre;

    public void comer() {
        println(nombre + " está comiendo.");
    }
}

@@@ OK archivo : ejemplo del enunciado Perro
// Subclase (Clase hija) que hereda de Animal
public class Perro extends Animal {
    public void ladrar() {
        println(nombre + " está ladrando: ¡Guau, guau!");
    }
}

@@@ OK archivo : ejemplo del enunciado Impresora
class Impresora {
    public void imprimir() {
        println("Imprimiendo documento genérico...");
    }
}

@@@ OK archivo : ejemplo del enunciado ImpresoraPDF
class ImpresoraPDF extends Impresora {
    @Override
    public void imprimir() {
        println("Imprimiendo en formato .PDF optimizado...");
    }
}

@@@ OK archivo : ejemplo del enunciado ImpresoraExcel
class ImpresoraExcel extends Impresora {
    @Override
    public void imprimir() {
        println("Imprimiendo hojas de cálculo en formato tabular...");
    }
}

@@@ SINTACTICO archivo : archivo vacio

@@@ SINTACTICO archivo : solo comentarios
// nada por aqui
/* ni por aca */

@@@ SINTACTICO archivo : dos clases en el mismo archivo
class A {}
class B {}

@@@ SINTACTICO archivo : codigo despues de la clase
class A {}
int x;

@@@ SINTACTICO archivo : falta el nombre de la clase
public class {
}

@@@ SINTACTICO archivo : falta la palabra class
public A {
}

@@@ SINTACTICO archivo : falta llave de cierre
public class A {
    int x;

@@@ SINTACTICO archivo : falta llave de apertura
public class A
    int x;
}

@@@ SINTACTICO archivo : llave de cierre de mas
class A {
}
}

@@@ SINTACTICO archivo : herencia multiple
class C extends A, B {
}

@@@ SINTACTICO archivo : extends sin padre
class C extends {
}

@@@ SINTACTICO archivo : extends dos veces
class C extends A extends B {
}

@@@ SINTACTICO archivo : implements no existe
class C implements Runnable {
}

@@@ SINTACTICO archivo : interfaces no existen
interface Figura {
}

@@@ SINTACTICO archivo : paquetes no existen
package modelos;
class A {}

@@@ SINTACTICO archivo : imports no existen en zetariano
import modelos.Persona;
class A {}

@@@ SINTACTICO archivo : Override sobre la clase
@Override
class A {}

@@@ SINTACTICO archivo : nombre de clase es palabra reservada
class super {
}

@@@ SINTACTICO archivo : nombre de clase empieza con numero
class 2Clase {
}

@@@ SINTACTICO archivo : clase anidada
class A {
    class B {}
}

@@@ SINTACTICO archivo : parentesis en la declaracion de clase
class A() {
}

@@@ SINTACTICO archivo : punto y coma despues de la clase
class A {
};

@@@ SINTACTICO archivo : modificador despues de class
class public A {
}
