@@@ OK : parametros y retornos decimales en Y
@@> salida: 3.75 14.0 2.75
=== main.pig
import lib.f.y
MAIOR>
>> promedio(3, 4.5) >> " " >> area(2.0) >> " " >> promedio(promedio(1, 3), area(1));
FINIS;
=== lib/f.y
%funciones
definir promedio(flotante a, flotante b) -> flotante:
    retornar (a + b) / 2

definir area(flotante r) -> flotante:
    retornar 3.5 * r * r

@@@ OK : recursividad con decimales
@@> salida: 5.0625 1024.0 1.0
=== main.pig
import lib.p.y
MAIOR>
>> potencia(1.5, 4) >> " " >> potencia(2, 10) >> " " >> potencia(9.75, 0);
FINIS;
=== lib/p.y
%funciones
definir potencia(flotante b, entero e) -> flotante:
    si (e == 0) entonces
        retornar 1.0
    retornar b * potencia(b, e - 1)

@@@ OK : estructura de Y con campo flotante
@@> salida: 10.0|Pan|11.0
=== main.pig
import lib.s.y
VARIABILES>
esto p : Producto {"Pan", 2.5, 4};
MAIOR>
>> total(p) >> "|" >> p.nombre;
subir(p);
>> "|" >> total(p);
FINIS;
=== lib/s.y
%estructuras
estructura Producto:
    cadena nombre
    flotante precio
    entero cantidad
%funciones
definir total({}Producto p) -> flotante:
    retornar p.precio * p.cantidad

definir subir({}Producto p):
    p.precio = p.precio + 0.25

@@@ OK : arreglo de decimales suma y mayor
@@> salida: 7.0 3.0 1.75
=== main.pig
VARIABILES>
series d[4] : decimalis {1.5, 2.25, 3.0, 0.25};
esto suma : decimalis 0.0;
esto mayor : decimalis 0.0;
MAIOR>
per (esto i : numerus 0; i < 4; i++) {
    suma = suma + d[i];
    si (d[i] > mayor) {
        mayor = d[i];
    } finis;
}
>> suma >> " " >> mayor >> " " + suma / 4;
FINIS;

