@@@ OK : despacho dinamico que retorna decimales
@@> salida: 12.0|6.0|0.0|18.0
=== main.pig
import Figura.z
import Circulo.z
import Rectangulo.z
VARIABILES>
series f[3] : Figura;
esto total : decimalis 0.0;
MAIOR>
f[0] = novus Circulo(2);
f[1] = novus Rectangulo(1.5, 4);
f[2] = novus Figura();
per (esto k : numerus 0; k < 3; k++) {
    >> f[k].area() >> "|";
    total = total + f[k].area();
}
>> total;
FINIS;
=== Figura.z
public class Figura {
    public Figura() {
    }
    public double area() {
        return 0.0;
    }
}
=== Circulo.z
public class Circulo extends Figura {
    private double radio;
    public Circulo(double radio) {
        this.radio = radio;
    }
    @Override
    public double area() {
        return 3.0 * radio * radio;
    }
}
=== Rectangulo.z
public class Rectangulo extends Figura {
    private double ancho;
    private double alto;
    public Rectangulo(double ancho, double alto) {
        this.ancho = ancho;
        this.alto = alto;
    }
    @Override
    public double area() {
        return ancho * alto;
    }
}

