@@@ OK : estructuras anidadas y con arreglos (se crean con sus partes)
@@> c3d: H =
=== lib/e.y
%estructuras
estructura Direccion:
    cadena calle
estructura Persona:
    entero edad
    entero notas[3]
    Direccion casa
%funciones
definir crear() -> Persona:
    Persona p
    p.notas[0] = 10
    p.casa.calle = "Central"
    retornar p

