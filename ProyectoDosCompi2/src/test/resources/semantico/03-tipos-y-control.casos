Tipos, expresiones, variables y control de flujo en los tres lenguajes.

@@@ OK : promocion de entero a decimal en expresiones (aclaracion de la auxiliar)
@@> c3d: (double)
=== Cuenta.z
public class Cuenta {
    private double saldo;
    public boolean retirar(double monto) {
        if (monto <= 0) {
            return false;
        }
        if (getSaldo() - monto < 0 - 100) {
            return false;
        }
        saldo = saldo - monto;
        int veces = 2;
        double total = veces * monto + 1;
        total += veces;
        return true;
    }
    public double getSaldo() {
        return saldo;
    }
}

