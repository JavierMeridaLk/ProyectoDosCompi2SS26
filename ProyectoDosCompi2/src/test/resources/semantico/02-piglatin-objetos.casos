@@@ ERROR : argumentos que no acepta ningun metodo
@@> error: Ningún método 'saludar' de la clase 'Persona' acepta los argumentos (textum)
=== main.pig
import Persona.z
VARIABILES>
esto p : novus Persona() : Persona ;
MAIOR>
p.saludar("hola");
FINIS;
=== Persona.z
public class Persona {
    public Persona() {
    }
    public void saludar(int veces) {
    }
}

@@@ OK : sobrecarga elegida por los argumentos y metodos encadenados
=== main.pig
import Persona.z
VARIABILES>
esto p : novus Persona() : Persona ;
MAIOR>
p.saludar(3);
p.saludar("hola");
>> p.yo().yo().edad();
>> novus Persona().edad();
FINIS;
=== Persona.z
public class Persona {
    public Persona() {
    }
    public void saludar(int veces) {
    }
    public void saludar(String texto) {
    }
    public Persona yo() {
        return this;
    }
    public int edad() {
        return 1;
    }
}

@@@ ERROR : metodo sobre un primitivo
@@> error: Un valor de tipo 'numerus' no tiene métodos
=== main.pig
VARIABILES>
esto n : numerus 1;
MAIOR>
n.m();
FINIS;

