@@@ OK : metodos recursivos en objetos
@@> salida: 21 8
=== main.pig
import Mat.z
VARIABILES>
esto m : novus Mat() : Mat ;
MAIOR>
>> m.fib(8) >> " " >> m.mcd(48, 40);
FINIS;
=== Mat.z
public class Mat {
    public Mat() {
    }
    public int fib(int n) {
        if (n < 2) {
            return n;
        }
        return fib(n - 1) + fib(n - 2);
    }
    public int mcd(int a, int b) {
        if (b == 0) {
            return a;
        }
        return mcd(b, a % b);
    }
}

