Pig Latin con objetos: tipo explicito, null y visibilidad desde fuera de las clases.

@@@ OK : objeto con tipo explicito del enunciado
=== main.pig
import Persona.z
import Profesor.z
VARIABILES>
esto miObjeto : novus Persona(12, "Profesor") : Persona ;
esto otroObjeto : novus Profesor(12, miObjeto, novus Persona(1, "x")) : Persona ;
esto nulo : null : Persona ;
MAIOR>
FINIS;
=== Persona.z
public class Persona {
    public Persona(int edad, String nombre) {
    }
}
=== Profesor.z
public class Profesor extends Persona {
    public Profesor(int edad, Persona jefe, Persona otra) {
        super(edad, "profe");
    }
}

@@@ ERROR : tipo explicito que no es superclase
@@> error: No se puede asignar un valor de tipo 'Persona' a uno de tipo 'Profesor'
=== main.pig
import Persona.z
import Profesor.z
VARIABILES>
esto p : novus Persona() : Profesor ;
MAIOR>
FINIS;
=== Persona.z
public class Persona {
    public Persona() {
    }
}
=== Profesor.z
public class Profesor extends Persona {
    public Profesor() {
    }
}

@@@ ERROR : tipo explicito de clase que no existe
@@> error: El tipo 'Fantasma' no está definido
=== main.pig
import Persona.z
VARIABILES>
esto p : null : Fantasma ;
MAIOR>
FINIS;
=== Persona.z
public class Persona {
}

@@@ ERROR : valor primitivo con tipo de clase
@@> error: No se puede asignar un valor de tipo 'numerus' a uno de tipo 'Persona'
=== main.pig
import Persona.z
VARIABILES>
esto p : 5 : Persona ;
MAIOR>
FINIS;
=== Persona.z
public class Persona {
}

@@@ OK : objeto copiado de otra variable con tipo del padre
=== main.pig
import Persona.z
import Profesor.z
VARIABILES>
esto a : novus Profesor() : Profesor ;
esto b : a : Persona ;
MAIOR>
FINIS;
=== Persona.z
public class Persona {
    public Persona() {
    }
}
=== Profesor.z
public class Profesor extends Persona {
    public Profesor() {
    }
}

@@@ OK : forma sin tipo del proyecto 1
=== main.pig
import Persona.z
VARIABILES>
esto p : novus Persona();
MAIOR>
p.saludar();
FINIS;
=== Persona.z
public class Persona {
    public Persona() {
    }
    public void saludar() {
    }
}

@@@ OK : asignar y comparar con null
=== main.pig
import Persona.z
VARIABILES>
esto p : null : Persona ;
MAIOR>
si (p == null) {
    p = novus Persona();
} finis;
si (p != null && null == p) {
    p = null;
} finis;
FINIS;
=== Persona.z
public class Persona {
    public Persona() {
    }
}

@@@ ERROR : null a una variable primitiva
@@> error: No se puede asignar un valor de tipo 'null' a uno de tipo 'numerus'
=== main.pig
VARIABILES>
esto n : numerus 0;
MAIOR>
n = null;
FINIS;

