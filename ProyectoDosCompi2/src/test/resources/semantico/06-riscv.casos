MAIOR>
>> suma(2000);
FINIS;
=== lib/r.y
%funciones
definir suma(entero n) -> entero:
    si (n == 0) entonces
        retornar 0
    retornar n + suma(n - 1)

@@@ OK : llamadas anidadas como argumentos
@@> salida: 55 256 16
=== main.pig
import lib.n.y
MAIOR>
>> mayor(sumar(10), mayor(3, cuadrado(4))) >> " " >> cuadrado(cuadrado(cuadrado(2))) >> " " >> mayor(cuadrado(2), cuadrado(4));
FINIS;
=== lib/n.y
%funciones
definir mayor(entero a, entero b) -> entero:
    si (a > b) entonces
        retornar a
    retornar b

definir cuadrado(entero x) -> entero:
    retornar x * x

definir sumar(entero n) -> entero:
    entero s = 0
    para (entero i = 1; i <= n; i++):
        s = s + i
    retornar s

