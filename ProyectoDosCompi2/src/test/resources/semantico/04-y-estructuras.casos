@@@ ERROR : funcion duplicada
@@> error: Ya existe una función llamada 'f'
=== lib/e.y
%funciones
definir f():
    retornar
definir f(entero x):
    retornar

@@@ ERROR : romper y continuar fuera de ciclos
@@> error: 'romper' solo se puede usar dentro de un ciclo o de un elegir
@@> error: 'continuar' solo se puede usar dentro de un ciclo
=== lib/e.y
%funciones
definir f():
    romper
    continuar

@@@ OK : romper dentro de elegir
=== lib/e.y
%funciones
definir f(entero x):
    elegir(x):
        caso 1:
            romper
        siempre:
            romper

